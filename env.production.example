# Production environment variables for AWS Amplify
#
# Copy these into:
#   Amplify Console -> your app -> Hosting -> Environment variables
#
# DO NOT commit this file with real values. This is a reference template.

# --- Runtime ---
NODE_ENV=production

# --- Cookie signing ---
# Used by infuseJwtCookie (app/constants/infuse-cookie.server.ts).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace-me-with-32-bytes-of-hex

# --- Optional: public URL ---
# Only needed if any loader/action builds absolute URLs for redirects,
# OG tags, etc. Safe to omit for the initial deploy.
PUBLIC_URL=https://infuse.bryanharrigan.dev

# NOTE: The Absorb base URL is hardcoded in app/.server/infuse-api.ts as
# `InfuseBaseUrl = "https://bryanh.myabsorb.com/api/rest/v2"`. No env var
# required. If you ever want to swap tenants (e.g. staging), refactor that
# constant to read from process.env.INFUSE_BASE_URL and add it here.
