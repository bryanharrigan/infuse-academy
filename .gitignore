node_modules

/.cache
/build
.env
.env.local
# Every .env variant holds live secrets. .env.production was UNTRACKED and
# UNIGNORED on the origin machine (14 Oct) - one `git add -A` from being
# published to this PUBLIC repo. Ignore the whole family.
.env.*
!.env.example

# Vite writes these when reloading vite.config.ts under Node ESM — they're
# transient and shouldn't be tracked.
vite.config.ts.timestamp-*.mjs

# Infuse OAuth admin refresh token — NEVER commit
.infuse-admin-token.json

# Local certificates — NEVER commit
/certs/*.pem
/certs/*.key
/certs/*.crt
!/certs/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/settings.json
.idea
certs/**
!certs/.gitkeep
