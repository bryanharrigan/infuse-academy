# =============================================================================
# Cross-portal LTI 1.3 tool — environment
# Append the parts you need to .env. See LTI_SETUP.md for the full walkthrough.
# =============================================================================

# ─── Tool identity ───────────────────────────────────────────────────────────
# Public base URL of this app. No trailing slash.
PUBLIC_URL=https://infuse.bryanharrigan.dev

# RSA private key (PKCS#8 PEM) used to sign deep-linking responses and AGS
# client assertions. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out lti-private.pem
# Literal \n escapes are accepted as well as real newlines.
# MUST be stable across deploys — rotating it breaks saved platform registrations.
LTI_TOOL_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----

# `kid` published in our JWKS and set on everything we sign. Any stable string.
LTI_TOOL_KID=infuse-lti-1

# Derives the stable per-learner password for provisioned accounts.
# Falls back to COOKIE_SECRET if unset. Rotating it orphans existing learners.
LTI_PROVISION_SECRET=

# ─── Host portals allowed to launch this tool ────────────────────────────────
# JSON array. Values come from the host portal's LTI Registration tile.
# `deploymentIds` may start empty: the launch handler then accepts any
# deployment and logs the one it saw, which is the quickest way to learn the
# value. Fill it in afterwards.
LTI_PLATFORMS=[{"id":"host-portal","issuer":"https://HOSTPORTAL.myabsorb.com","clientId":"PASTE_CLIENT_ID","deploymentIds":[],"authUrl":"https://HOSTPORTAL.myabsorb.com/lti/authorize","tokenUrl":"https://HOSTPORTAL.myabsorb.com/lti/token","jwksUrl":"https://HOSTPORTAL.myabsorb.com/lti/jwks"}]

# ─── Source portal (holds the Online Courses) ────────────────────────────────
# Every one of these falls back to the app's existing INFUSE_* / ABSORB_REST_URL
# vars, so leave them unset to run the LTI flow against the portal already wired.
# Set them to point the LTI flow at a DIFFERENT portal than the main app uses.

# Tenant Integration API v2 — note the /api/rest/v2 suffix
LTI_SOURCE_BASE_URL=https://SOURCE.myabsorb.com/api/rest/v2

# Infuse API host (paid add-on). Region-specific.
#   US https://infuse.myabsorb.com   EU https://infuse.myabsorb.eu
#   CA https://infuse.myabsorb.ca    AU https://infuse.myabsorb.com.au
LTI_SOURCE_API_URL=https://infuse.myabsorb.com

# Tenant portal — where the player pages live, and what gets framed.
LTI_SOURCE_PORTAL_URL=https://SOURCE.myabsorb.com

# Infuse API key for the source tenant. Needs Integration API user-management
# and enrolment permission, not just read.
LTI_SOURCE_API_KEY=

# Admin Integration API gateway. REGION-SPECIFIC, and NOT the same host as
# LTI_SOURCE_BASE_URL. Pointing at the wrong region fails with an unhelpful
# error and is the most common early mistake on this project.
#   US https://rest.myabsorb.com    CA https://rest.myabsorb.ca
#   EU https://rest.myabsorb.eu     AU https://rest.myabsorb.com.au
LTI_SOURCE_REST_URL=https://rest.myabsorb.com

# Department for provisioned learners. Optional — Absorb uses its default.
# Worth setting: it makes LTI-provisioned accounts one filter and one bulk
# action to clean up, the way the embed's demo- accounts already are.
LTI_SOURCE_DEPARTMENT_ID=

# ─── Completion webhook (source portal) ──────────────────────────────────────
# Source portal → Client Settings → Webhooks → Add webhook
#   URL:    {PUBLIC_URL}/api/lti/webhook
#   Events: Enrollment Completed by Learner
# Paste the generated Secret Key here.
LTI_WEBHOOK_SECRET=

# ─── Integration API on the source portal (per-learner provisioning) ─────────
# A DIFFERENT product and a DIFFERENT key from the Infuse API key above.
# The Integration API is a paid add-on; its key is the "REST API Private Key"
# (sometimes shown as "Rest V2 API Key") in Portal Settings > Info on the
# SOURCE portal. Sending the Infuse key to rest.myabsorb.* returns 403.
LTI_SOURCE_REST_API_KEY=

# Only needed if the tenant requires an API token rather than the key alone.
# The code tries the key by itself first and escalates to
# POST /authenticate -> Authorization header only if that is refused.
LTI_SOURCE_ADMIN_USERNAME=
LTI_SOURCE_ADMIN_PASSWORD=

# ─── Shared-learner fallback (DEMO ONLY) ────────────────────────────────────
# One pre-made learner on the source portal that every launch plays as. Needs
# no Integration API. Used when the values above are unset, or when
# per-learner provisioning fails.
#
# Progress is SHARED between everyone, and AGS attribution is ambiguous with
# more than one tester at a time, because every launch resolves to the same
# source-portal user. The player page shows a banner when this is active.
LTI_SOURCE_LEARNER_USERNAME=
LTI_SOURCE_LEARNER_PASSWORD=

# ─── SMOWL proctoring (optional) ────────────────────────────────────────────
# Wraps the player with SMOWL's monitoring iframe and hides the course until
# its camera/identity checks pass. Leave unset and the player behaves exactly
# as it does without proctoring.
#
# All four come from Smowltech when the entity is provisioned. The guide calls
# them VAR1, VAR2, VAR3 and the JWT secret respectively.
SMOWL_ENTITY_NAME=
SMOWL_ENTITY_KEY=
SMOWL_API_KEY=
SMOWL_JWT_SECRET=

# The JWT `aud` claim. SMOWL's own code samples leave this as the placeholder
# `smowl_platform_domain` — it is per-entity and they supply it with the
# licence. Unset, the tool falls back to the host of LTI_TOOL_BASE_URL, which
# is a guess; set it to whatever Smowltech gives you.
SMOWL_AUDIENCE=

# Interface language for SMOWL's blocks. en, es, fr, pt, it, de
SMOWL_LANG=en

# Support confirmed this is free text, max 50 chars -- test and quiz are only
# the common values, not the only accepted ones. Keep it consistent per
# activity type so the SMOWL reports stay filterable.
SMOWL_ACTIVITY_TYPE=course

# Appended to every SMOWL userId before it is sent.
#
# SMOWL keys a face registration to userId, and mySmowltech has no delete
# action on the Registrations report -- once a learner has registered, the
# first-run registration experience cannot be shown again. Bumping this makes
# every learner a user SMOWL has never seen, so registration replays.
#
# Reversible: set it back to a previous value and the old registrations are
# live again. Leave it EMPTY outside a demo -- each bump orphans the previous
# registrations and consumes licence units afresh.
SMOWL_USER_SALT=

# ─── Player chrome ──────────────────────────────────────────────────────────
# How much explanatory banner the player page carries.
#
#   off      nothing but the course (and the proctor panel, which is UI)
#   minimal  completion status only -- the evidence that passback worked
#   all      every banner, as during development
#
# Default is minimal. Note the trade: "off" and "minimal" both hide the
# shared-learner notice, which exists so a demo is never mistaken for real
# per-learner provisioning. Fine while you are presenting and know every
# launch shares one account; not fine if someone else is driving.
LTI_PLAYER_BANNERS=minimal
