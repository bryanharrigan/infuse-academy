# =============================================================================
# Infuse Local — Environment Configuration
# Copy this file to .env and fill in your real values
#   cp .env.example .env
# The real .env file is gitignored — NEVER commit it
# =============================================================================

# ─── Absorb Hosts ─────────────────────────────────────────────────────────────
# Three distinct URLs:
#
#   1. Legacy Integration API v2 on the tenant subdomain.
#      Used by /authentication (sign-in), /my-courses, /my-catalog.
INFUSE_BASE_URL=https://YOUR_TENANT.myabsorb.com/api/rest/v2

#   2. Infuse API (global host, tenant identified by x-api-key).
#      Used by /authentication/basic-authentication-tokens and
#      /online-courses/:id/chapters.
#      US: https://infuse.myabsorb.com
#      EU: https://infuse.myabsorb.eu | AU: https://infuse.myabsorb.com.au
INFUSE_API_URL=https://infuse.myabsorb.com

#   3. Tenant portal — where the player pages live. Iframed as the player UI.
INFUSE_PORTAL_URL=https://YOUR_TENANT.myabsorb.com

# Your Infuse API Key (from Admin → Integrations → Infuse API)
INFUSE_API_KEY=paste_your_api_key_here

# ─── Local server ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5173

# ─── Cookie signing ───────────────────────────────────────────────────────────
# Any long random string. Use `openssl rand -base64 48` to generate one.
COOKIE_SECRET=change_me_to_a_long_random_string

# ─── Optional: trust self-signed certs in dev (do not set in production) ──────
# NODE_TLS_REJECT_UNAUTHORIZED=0
