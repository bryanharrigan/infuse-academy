<?xml version="1.0" encoding="UTF-8"?>
<!--
  SCORM 1.2 Content Aggregation Package.

  One SCO, so the LMS tracks a single completion and score for the module.
  Mastery score 80 matches the pass mark enforced in the knowledge check.
-->
<manifest identifier="ABSORB-ECHO-WINDOWS-1-2"
          version="1.0"
          xmlns="http://www.imsproject.org/xsd/imscp_rootv1p1p2"
          xmlns:adlcp="http://www.adlnet.org/xsd/adlcp_rootv1p2"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.imsproject.org/xsd/imscp_rootv1p1p2 imscp_rootv1p1p2.xsd
                              http://www.imsglobal.org/xsd/imsmd_rootv1p2p1 imsmd_rootv1p2p1.xsd
                              http://www.adlnet.org/xsd/adlcp_rootv1p2 adlcp_rootv1p2.xsd">

  <metadata>
    <schema>ADL SCORM</schema>
    <schemaversion>1.2</schemaversion>
  </metadata>

  <organizations default="echo-windows-org">
    <organization identifier="echo-windows-org" structure="hierarchical">
      <title>Echocardiographic Windows</title>
      <item identifier="item-echo-windows" identifierref="res-echo-windows" isvisible="true">
        <title>Echocardiographic Windows</title>
        <adlcp:masteryscore>80</adlcp:masteryscore>
      </item>
    </organization>
  </organizations>

  <resources>
    <resource identifier="res-echo-windows"
              type="webcontent"
              adlcp:scormtype="sco"
              href="index.html">
      <file href="index.html"/>
      <file href="assets/course.css"/>
      <file href="assets/course.js"/>
      <file href="assets/heart.bin"/>
      <file href="assets/anatomy.json"/>
      <file href="assets/ATTRIBUTION.txt"/>
    </resource>
  </resources>

</manifest>
